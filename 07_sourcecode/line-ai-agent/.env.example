# ==============================
# LINE Official Account (Required)
# ==============================
LINE_CHANNEL_SECRET=your_line_channel_secret
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token

# ==============================
# Gemini AI (Required for AI replies)
# ==============================
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash

# ==============================
# dh-task / klive API
# ==============================
KLIVE_API_URL=https://tasks.dohome.technology/api
KLIVE_TASKS_API_URL=https://tasks.dohome.technology/api
KLIVE_API_TOKEN=your_klive_api_token

# ==============================
# Self identity in dh-task
# ==============================
SELF_EMAIL=wirun.pin@dohome.co.th

# ==============================
# Access control / approval flow
# ==============================
ADMIN_LINE_USER_ID=
LIFF_ID=
LIFF_PROJECT_ID=

# ==============================
# Cron / public URL
# ==============================
CRON_SECRET=
PUBLIC_BASE_URL=https://pj-linebot.onrender.com

# ==============================
# Firestore (optional for local debug)
# ==============================
GOOGLE_APPLICATION_CREDENTIALS=
FIRESTORE_PROJECT_ID=
FIRESTORE_COLLECTION=bot_users
